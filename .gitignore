# Ignore everything
*

# Unignore directories so git can traverse into them
!*/

# ===== ROOT FILES =====
!index.html
!package.json
!package-lock.json
!vite.config.js
!README.md
!.gitignore

# ===== SOURCE FILES =====
!src/main.jsx
!src/App.jsx

# Global styles
!src/styles/index.css

# Components
!src/components/Header.jsx
!src/components/Header.css
!src/components/Hero.jsx
!src/components/Hero.css
!src/components/Services.jsx
!src/components/Products.jsx
!src/components/About.jsx
!src/components/Section.css
!src/components/Footer.jsx
!src/components/Footer.css

# ===== PUBLIC ASSETS =====
# Images are tracked; videos are not (use Git LFS or external hosting for video)
!public/.gitkeep
!public/*.jpg
!public/*.png
!public/*.svg
!public/*.gif
